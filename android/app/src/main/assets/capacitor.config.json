{
	"appId": "com.albanmurad.erp",
	"appName": "ئەلبان موراد ERP",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#0B0F19",
			"showSpinner": true,
			"androidSpinnerStyle": "large",
			"spinnerColor": "#3B82F6",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"backgroundColor": "#0B0F19",
			"style": "DARK"
		}
	}
}
